<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="14dp">

    <include
        layout="@layout/widget_today_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="45" />

    <LinearLayout
        android:id="@+id/widget_steps"
        android:layout_width="0dp"
        android:layout_height="184dp"
        android:layout_marginStart="10dp"
        android:layout_weight="55"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_step1"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_step_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <ImageView
                    android:id="@+id/widget_step1_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_circle" />

                <TextView
                    android:id="@+id/widget_step1_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#FF000000"
                    android:textSize="13sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_step1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_step1_check"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/widget_check_step"
                android:padding="7dp"
                android:src="@drawable/widget_check_open" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_step2"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_step_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <ImageView
                    android:id="@+id/widget_step2_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_circle" />

                <TextView
                    android:id="@+id/widget_step2_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#FF000000"
                    android:textSize="13sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_step2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_step2_check"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/widget_check_step"
                android:padding="7dp"
                android:src="@drawable/widget_check_open" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_step3"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_step_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <ImageView
                    android:id="@+id/widget_step3_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_circle" />

                <TextView
                    android:id="@+id/widget_step3_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#FF000000"
                    android:textSize="13sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_step3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_step3_check"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/widget_check_step"
                android:padding="7dp"
                android:src="@drawable/widget_check_open" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_add_step"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/widget_add_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_add_step"
                android:textColor="#FF8E8E8E"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_plus" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

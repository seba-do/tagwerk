<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="92dp"
        android:layout_height="92dp">

        <ImageView
            android:id="@+id/widget_circle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle" />

        <ImageView
            android:id="@+id/widget_ring"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_circle_running"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✅"
            android:textColor="#FF000000"
            android:textSize="24sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFE6E6E6"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp" />

    <ImageView
        android:id="@+id/widget_title_image"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_running_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFE6E6E6"
        android:textSize="14sp"
        android:visibility="gone" />

    <Chronometer
        android:id="@+id/widget_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="19sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_timer_paused"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="19sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_start"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_start_background"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Start ▶&#xFE0E;"
        android:textColor="#FF000000"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_extend"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_control_background"
            android:contentDescription="Fünf Minuten mehr"
            android:gravity="center"
            android:text="+5"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_pause"
            android:layout_width="46dp"
            android:layout_height="34dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/widget_start_background"
            android:scaleType="center"
            android:src="@drawable/widget_pause" />

        <ImageView
            android:id="@+id/widget_finish"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_control_background"
            android:contentDescription="Erledigt"
            android:scaleType="center"
            android:src="@drawable/widget_finish" />
    </LinearLayout>
</LinearLayout>
